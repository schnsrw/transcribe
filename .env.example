# Casual-SST environment variables
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored.
#
# All variables are OPTIONAL unless marked **REQUIRED**. Most have
# sensible defaults; the .env layer is for overrides + secrets.
# ----------------------------------------------------------------------------

# ---- Server ----------------------------------------------------------------
# Config file to load. Defaults to config/local.yaml inside the container,
# config/dev-mac.yaml on `make dev-mac`, config/dev-linux.yaml on
# `make dev-linux`. Override here only if you have a custom config.
CONFIG_PATH=/app/config/prod.yaml

# Verbosity of the in-memory log ring buffer (and stdout). DEBUG / INFO
# / WARNING / ERROR / CRITICAL.
LOG_LEVEL=INFO


# ---- Admin / monitoring portal --------------------------------------------
# When set, exposes the admin dashboard at /admin and the JSON API under
# /admin/api/*. Unset → portal returns 404 for every route (disabled).
# Generate something strong:  openssl rand -hex 32
ADMIN_TOKEN=

# ---- JWT auth (production) -------------------------------------------------
# Used when config.server.bypass_auth = false (i.e. config/prod.yaml).
# We accept either ASAP-style asymmetric keys (Jitsi standard) or a
# shared HMAC secret, whichever is set.

# ASAP asymmetric: directory of *.pem public keys, one per audience.
ASAP_PUB_KEYS_FOLDER=
# Allowed JWT audiences, comma-separated.
ASAP_PUB_KEYS_AUDS=
# Optional URL to fetch public keys from (Jitsi's convention).
ASAP_PUB_KEYS_REPO_URL=

# Shared-secret fallback (HMAC). Only used if no ASAP keys present.
# JWT_SECRET=
# JWT_ALGORITHM=HS256
# JWT_AUDIENCE=casual-sst


# ---- Hugging Face / model downloads ---------------------------------------
# Anonymous downloads work but rate-limit aggressively. Set this to
# raise the limits and speed up first-call model fetches.
HF_TOKEN=

# Override the default whisper model used by the whisper_turbo backend.
# Same values as `WHISPER_MODEL_NAME` in faster-whisper:
#   tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
# (Set this here or per-backend in your config YAML.)
# WHISPER_MODEL=large-v3-turbo

# Where to cache models inside the container. Default points at the
# mounted hf-cache volume; override only for custom layouts.
HF_HOME=/cache/huggingface


# ---- LLM module (optional, off by default) --------------------------------
# Setting any of these enables the /api/summarize endpoint.
#
# Backend selection — first non-empty wins:
#   openai     → uses OPENAI_API_KEY + OPENAI_BASE_URL
#   ollama     → uses OLLAMA_HOST (default http://localhost:11434)
LLM_BACKEND=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b


# ---- Dev-mac script (host-mode only) --------------------------------------
# Set RELOAD=1 to enable uvicorn auto-reload while iterating on src/.
# Costs 5-10 s of MLX kernel re-warmup on every save, so off by default.
# RELOAD=1

# Override the Python interpreter the dev-mac.sh / dev-linux.sh scripts
# use to bootstrap their venv. Defaults to first python3.11+ on PATH.
# PYTHON=/opt/homebrew/bin/python3.12


# ---- Observability (optional) ---------------------------------------------
# Prometheus metrics endpoint is always at /metrics; nothing to configure.
# Add a scrape config in prometheus.yaml on the metrics-collector side.
